<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <FontFamily x:Key="DpUiFont">/Resources/Fonts/#Be Vietnam Pro, Segoe UI</FontFamily>
    <!-- Nội dung văn bản dùng chữ như văn bản hành chính (Tinos của mockup tương đương Times New Roman). -->
    <FontFamily x:Key="DpBodyFont">Times New Roman</FontFamily>

    <Style x:Key="DpText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpUiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource DpInkBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DpMuted" TargetType="TextBlock" BasedOn="{StaticResource DpText}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource DpInk3Brush}" />
    </Style>

    <Style x:Key="DpColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource DpMuted}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DpPageTitle" TargetType="TextBlock" BasedOn="{StaticResource DpText}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="DpBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DpBodyFont}" />
        <Setter Property="FontSize" Value="17.5" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource DpInkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Vòng focus vàng 2px như mockup. -->
    <Style x:Key="DpFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{DynamicResource DpHlBrush}" StrokeThickness="2" RadiusX="6" RadiusY="6" Margin="-2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thanh điều hướng trái: biểu tượng trên, nhãn dưới; mục đang chọn tô nền bia2 và biểu tượng vàng. -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="58" />
        <Setter Property="Foreground" Value="{DynamicResource DpBiaMBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DpUiFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DpFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" CornerRadius="8" Background="Transparent">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon x:Name="Icon" FontSize="22" HorizontalAlignment="Center"
                                           Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0"
                                              TextElement.FontSize="11" TextElement.FontWeight="Normal"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DpBia2Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DpBiaTBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DpBia2Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DpBiaTBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DpHlBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bộ lọc dạng nút gộp: nền line2 bao ngoài, mục chọn nổi lên trên nền giấy. -->
    <Style x:Key="SegTab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource DpUiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource DpInk2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DpFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Height="30" Padding="12,0" CornerRadius="6" Background="Transparent">
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DpInkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DpPaperBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DpInkBrush}" />
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hàng của bảng: kẻ line2 ở đáy, rê chuột đổi nền panel. -->
    <Style x:Key="DpRow" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DpFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource DpLine2Brush}" BorderThickness="0,0,0,1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DpPanelBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DpPanelBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DpList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DpRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    </Style>

    <!-- Một chỗ khớp trong cột bên trái; đang chọn thì nền actT, viền actL (DataContext là HitRow). -->
    <Style x:Key="HitItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DpFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DpLine2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DpActTBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DpActLBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Vạch của bản đồ văn bản. MinHeight là độ dày của vạch; Tag là độ dài. Vùng bấm cao hơn vạch. -->
    <Style x:Key="MapBar" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DpBarBrush}" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Height="7" Background="Transparent">
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1"
                                Height="{TemplateBinding MinHeight}" Background="{TemplateBinding Background}"
                                Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHit}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DpHlTBrush}" />
                <Setter Property="MinHeight" Value="5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DpHlBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Nhãn loại file: 28x28, màu theo loại. -->
    <Style x:Key="FileBadge" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource DpActTBrush}" />
    </Style>
</ResourceDictionary>
