<Page x:Class="DocPoint.App.Views.Pages.SearchResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:DocPoint.App.Controls"
      xmlns:vm="clr-namespace:DocPoint.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SearchResultsViewModel, IsDesignTimeCreatable=False}"
      Title="Kết quả tìm kiếm">

    <Page.Resources>
        <Style x:Key="ShowWhenRows" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRows}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenNoQuery" TargetType="TextBlock" BasedOn="{StaticResource DpText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Foreground" Value="{DynamicResource DpInk2Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasQuery}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenEmptyResult" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenInForce" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.Hit.Validity}" Value="InForce">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenExpired" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.Hit.Validity}" Value="Expired">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadingParagraph" TargetType="TextBlock" BasedOn="{StaticResource DpBody}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Chưa gõ gì / không có chỗ nào khớp -->
        <TextBlock Margin="40,32,40,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Style="{StaticResource ShowWhenNoQuery}"
                   Text="Gõ vào ô tìm kiếm phía trên để tìm trong mọi tài liệu." />
        <StackPanel Margin="40,32,40,0" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Style="{StaticResource ShowWhenEmptyResult}">
            <TextBlock Style="{StaticResource DpText}" FontSize="20" FontWeight="SemiBold" TextTrimming="None" TextWrapping="Wrap">
                <Run Text="Không có chỗ nào khớp với “" /><Run Text="{Binding Query, Mode=OneWay}" /><Run Text="”" />
            </TextBlock>
            <TextBlock Style="{StaticResource DpText}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Foreground="{DynamicResource DpInk2Brush}"
                       Text="Thử gõ ngắn hơn hoặc bỏ bớt từ. Gõ không dấu cũng được. Nếu thư mục còn đang được đọc, file mới có thể chưa tìm thấy." />
        </StackPanel>

        <Grid Style="{StaticResource ShowWhenRows}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: các chỗ khớp, nhóm theo tài liệu -->
            <Border Background="{DynamicResource DpPanelBrush}" BorderBrush="{DynamicResource DpLineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Padding="16,14,16,12" BorderBrush="{DynamicResource DpLine2Brush}" BorderThickness="0,0,0,1">
                            <TextBlock Style="{StaticResource DpText}" FontSize="13" Foreground="{DynamicResource DpInk2Brush}"
                                       Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite">
                                <Run FontWeight="Bold" Foreground="{DynamicResource DpInkBrush}" Text="{Binding HitCount, Mode=OneWay, StringFormat='{}{0} chỗ khớp'}" /><Run Text="{Binding DocumentCount, Mode=OneWay, StringFormat=' trong {0} tài liệu'}" />
                            </TextBlock>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,14,12,10" BorderBrush="{DynamicResource DpLine2Brush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Document24" FontSize="18" VerticalAlignment="Top" Margin="0,1,10,0"
                                                               Foreground="{DynamicResource DpInk3Brush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="DocName" Style="{StaticResource DpText}" FontWeight="Bold" Text="{Binding Name}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Style="{StaticResource DpMuted}" Text="{Binding Info}" />
                                                        <StackPanel x:Name="ValidityBox" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed">
                                                            <ui:SymbolIcon x:Name="ValidityIcon" Symbol="CheckmarkCircle16" FontSize="12" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="ValidityText" Style="{StaticResource DpMuted}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock x:Name="Note" Style="{StaticResource DpMuted}" Margin="0,2,0,0" Text="{Binding Note}"
                                                               Foreground="{DynamicResource DpBadBrush}" Visibility="Collapsed" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource DpMuted}" FontWeight="Bold" Margin="8,2,0,0"
                                                           Foreground="{DynamicResource DpInk2Brush}" Text="{Binding Count}" />
                                            </Grid>

                                            <ui:Button x:Name="Toggle" Appearance="Transparent" Padding="8,2" Margin="20,4,0,0" HorizontalAlignment="Left"
                                                       Foreground="{DynamicResource DpActBrush}" Content="{Binding ToggleText}"
                                                       Command="{Binding ToggleCommand}" Visibility="Collapsed" />

                                            <ItemsControl x:Name="Paths" ItemsSource="{Binding PathGroups}" Margin="8,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource DpMuted}" FontSize="13" Margin="8,2,0,2" Text="{Binding Path}" />
                                                            <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0,0,4">
                                                                <ItemsControl.Template>
                                                                    <ControlTemplate TargetType="ItemsControl">
                                                                        <Border BorderBrush="{DynamicResource DpLineBrush}" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                                                            <ItemsPresenter />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ItemsControl.Template>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource HitItem}" Margin="0,1"
                                                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                                CommandParameter="{Binding}">
                                                                            <StackPanel>
                                                                                <Border HorizontalAlignment="Left" CornerRadius="2" Padding="3,1"
                                                                                        Background="{DynamicResource DpHlBrush}">
                                                                                    <TextBlock Style="{StaticResource DpText}" FontSize="13" FontWeight="Bold"
                                                                                               Foreground="{DynamicResource DpHlInkBrush}" Text="{Binding ShortPosition}" />
                                                                                </Border>
                                                                                <TextBlock Style="{StaticResource DpMuted}" Margin="0,3,0,0"
                                                                                           Foreground="{DynamicResource DpInk2Brush}" Text="{Binding PlainSnippet}" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter TargetName="Paths" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Validity}" Value="InForce">
                                            <Setter TargetName="ValidityBox" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ValidityText" Property="Text" Value="Còn hiệu lực" />
                                            <Setter TargetName="ValidityText" Property="Foreground" Value="{DynamicResource DpOkBrush}" />
                                            <Setter TargetName="ValidityIcon" Property="Foreground" Value="{DynamicResource DpOkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Validity}" Value="Expired">
                                            <Setter TargetName="ValidityBox" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ValidityText" Property="Text" Value="Hết hiệu lực" />
                                            <Setter TargetName="ValidityText" Property="Foreground" Value="{DynamicResource DpBadBrush}" />
                                            <Setter TargetName="ValidityIcon" Property="Symbol" Value="DismissCircle16" />
                                            <Setter TargetName="ValidityIcon" Property="Foreground" Value="{DynamicResource DpBadBrush}" />
                                            <Setter TargetName="DocName" Property="TextDecorations" Value="Strikethrough" />
                                            <Setter TargetName="Note" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Giữa và phải: trang đọc và bản đồ văn bản -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Margin="32,24,16,24" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Padding="52,32,52,24" CornerRadius="4" Background="{DynamicResource DpPaperBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.12" Color="#102820" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DpMuted}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="{Binding Selected.Hit.Breadcrumb}" />
                            <TextBlock Style="{StaticResource DpText}" Margin="0,6,0,0" FontSize="30" FontWeight="Bold"
                                       TextWrapping="Wrap" TextTrimming="None" Text="{Binding Selected.Hit.Position}" />

                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource DpText}" FontSize="13" Foreground="{DynamicResource DpInk2Brush}"
                                           TextTrimming="None" Margin="0,0,10,0" Text="{Binding Selected.Hit.DocumentName}" />
                                <TextBlock Style="{StaticResource DpText}" FontSize="13" Foreground="{DynamicResource DpInk2Brush}"
                                           TextTrimming="None" Margin="0,0,10,0" Text="{Binding Selected.Hit.DocumentInfo}" />
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ShowWhenInForce}">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="13" Margin="0,0,3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DpOkBrush}" />
                                    <TextBlock Style="{StaticResource DpText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DpOkBrush}" Text="Còn hiệu lực" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ShowWhenExpired}">
                                    <ui:SymbolIcon Symbol="DismissCircle16" FontSize="13" Margin="0,0,3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DpBadBrush}" />
                                    <TextBlock Style="{StaticResource DpText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DpBadBrush}" Text="Hết hiệu lực" />
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ui:Button Content="Trích dẫn" Icon="{ui:SymbolIcon Copy16}" Command="{Binding CopyCitationCommand}"
                                           ToolTip="Sao chép trích dẫn" AutomationProperties.Name="Sao chép trích dẫn" />
                                <ui:Button Appearance="Primary" Content="Mở bản gốc" Margin="6,0,0,0" IsEnabled="False"
                                           ToolTip="Chưa mở được file gốc trong bản dùng thử này" />
                                <TextBlock Style="{StaticResource DpMuted}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" Text="{Binding CopyFeedback}" />
                            </StackPanel>

                            <Rectangle Height="1" Margin="0,20,0,18" Fill="{DynamicResource DpLine2Brush}" />

                            <ItemsControl ItemsSource="{Binding Selected.Paragraphs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Para" Style="{StaticResource ReadingParagraph}"
                                                   controls:HighlightText.Source="{Binding Text}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                <Setter TargetName="Para" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource DpMuted}" Margin="0,24,0,0" Text="Chỉ để tham khảo, cần đối chiếu văn bản gốc." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Bản đồ văn bản: vạch vàng là chỗ khớp, khung viền là đoạn đang xem. -->
                <StackPanel Grid.Column="1" Margin="0,32,16,0" Width="40" VerticalAlignment="Top"
                            AutomationProperties.Name="Bản đồ văn bản">
                    <Grid Width="28">
                        <ItemsControl ItemsSource="{Binding MapBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MapBar}" Tag="{Binding Length}"
                                            AutomationProperties.Name="{Binding Row.ShortPosition}"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding Row}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border VerticalAlignment="Top" Height="123" Margin="{Binding ViewportMargin}" CornerRadius="4"
                                BorderBrush="{DynamicResource DpActBrush}" BorderThickness="1.5" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Style="{StaticResource DpMuted}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" Text="Bản đồ">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
