<Page x:Class="DocPoint.App.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:DocPoint.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:HomeViewModel, IsDesignTimeCreatable=False}"
      Title="Mở gần đây">

    <Page.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupTitle" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="ShowWhenVisible" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenFirstRun" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirstRun}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowWhenNoMatch" TargetType="TextBlock" BasedOn="{StaticResource DpText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource DpInk2Brush}" />
            <Setter Property="TextTrimming" Value="None" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNoMatch}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32,40,40">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">

                <Grid>
                    <TextBlock Style="{StaticResource DpPageTitle}" Text="Mở gần đây" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Padding="3" CornerRadius="8" Background="{DynamicResource DpLine2Brush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegTab}" Content="Tất cả"
                                         IsChecked="{Binding IsAll, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RecentFilter.All}" />
                            <RadioButton Style="{StaticResource SegTab}" Content="Văn bản luật" Margin="2,0,0,0"
                                         IsChecked="{Binding IsLegal, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RecentFilter.Legal}" />
                            <RadioButton Style="{StaticResource SegTab}" Content="Word" Margin="2,0,0,0"
                                         IsChecked="{Binding IsWord, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RecentFilter.Word}" />
                            <RadioButton Style="{StaticResource SegTab}" Content="PDF" Margin="2,0,0,0"
                                         IsChecked="{Binding IsPdf, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RecentFilter.Pdf}" />
                            <RadioButton Style="{StaticResource SegTab}" Content="Excel" Margin="2,0,0,0"
                                         IsChecked="{Binding IsExcel, Mode=OneWay}"
                                         Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:RecentFilter.Excel}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Thẻ bảng: tiêu đề cột, rồi các nhóm theo ngày -->
                <Border Style="{StaticResource ShowWhenVisible}" Margin="0,12,0,0" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource DpPaperBrush}"
                        BorderBrush="{DynamicResource DpLineBrush}" BorderThickness="1">
                    <StackPanel>
                        <Border Padding="16,10" BorderBrush="{DynamicResource DpLineBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Style="{StaticResource DpColumnHeader}" Text="Tài liệu" />
                                <TextBlock Grid.Column="4" Style="{StaticResource DpColumnHeader}" Text="Đang xem tới" />
                                <TextBlock Grid.Column="6" Style="{StaticResource DpColumnHeader}" Text="Mở lúc" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListBox Style="{StaticResource DpList}"
                                 ItemsSource="{Binding Source={StaticResource Grouped}}"
                                 AutomationProperties.Name="Tài liệu mở gần đây">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,14,16,6" BorderBrush="{DynamicResource DpLine2Brush}" BorderThickness="0,0,0,1">
                                                <TextBlock Style="{StaticResource DpColumnHeader}" Text="{Binding Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,10,16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="Badge" Style="{StaticResource FileBadge}" VerticalAlignment="Center">
                                            <TextBlock x:Name="BadgeText" FontSize="10" FontWeight="Bold" Text="DOC"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DpActBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource DpText}" FontWeight="SemiBold" Text="{Binding Document.Name}" />
                                            <TextBlock Style="{StaticResource DpMuted}" Text="{Binding Document.Folder}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Style="{StaticResource DpText}" FontSize="13.5" VerticalAlignment="Center"
                                                   Text="{Binding Document.Position}" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource DpText}" FontSize="13" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource DpInk2Brush}"
                                                   Typography.NumeralAlignment="Tabular" Text="{Binding TimeText}" />
                                        <ui:Button x:Name="PinButton" Grid.Column="7" Appearance="Transparent" Padding="0" BorderThickness="0"
                                                   Width="30" Height="30" HorizontalAlignment="Right"
                                                   ToolTip="Ghim" AutomationProperties.Name="Ghim"
                                                   Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="16"
                                                           Foreground="{DynamicResource DpInk3Brush}" />
                                        </ui:Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Document.Kind}" Value="Legal">
                                            <Setter TargetName="BadgeText" Property="Text" Value="LUẬT" />
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DpBiaBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource DpBiaTBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Document.Kind}" Value="Pdf">
                                            <Setter TargetName="BadgeText" Property="Text" Value="PDF" />
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DpBadTBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource DpBadBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Document.Kind}" Value="Excel">
                                            <Setter TargetName="BadgeText" Property="Text" Value="XLS" />
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DpWarnTBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource DpWarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Document.Kind}" Value="Text">
                                            <Setter TargetName="BadgeText" Property="Text" Value="TXT" />
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DpLine2Brush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource DpInk2Brush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter TargetName="PinIcon" Property="Filled" Value="True" />
                                            <Setter TargetName="PinIcon" Property="Foreground" Value="{DynamicResource DpActBrush}" />
                                            <Setter TargetName="PinButton" Property="ToolTip" Value="Bỏ ghim" />
                                            <Setter TargetName="PinButton" Property="AutomationProperties.Name" Value="Bỏ ghim" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,12,0,0" Style="{StaticResource DpMuted}" FontSize="13"
                           Text="Chỉ lưu trên máy này" />

                <!-- Lần đầu mở app: dạy cách bắt đầu. -->
                <StackPanel Margin="0,32,0,0" MaxWidth="560" HorizontalAlignment="Left"
                            Style="{StaticResource ShowWhenFirstRun}">
                    <TextBlock Style="{StaticResource DpText}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="None" Text="Chưa có tài liệu nào" />
                    <TextBlock Style="{StaticResource DpText}" Margin="0,8,0,16" TextWrapping="Wrap" TextTrimming="None"
                               Foreground="{DynamicResource DpInk2Brush}"
                               Text="DocPoint đọc mọi file PDF, Word, Excel trong các thư mục bạn chọn, rồi chỉ ra đúng chỗ nội dung nằm. Thêm một thư mục để bắt đầu." />
                    <ui:Button Appearance="Primary" Content="Thêm thư mục" Icon="{ui:SymbolIcon FolderAdd24}"
                               Command="{Binding AddFolderCommand}" />
                </StackPanel>

                <TextBlock Margin="0,32,0,0" Style="{StaticResource ShowWhenNoMatch}"
                           Text="Không có tài liệu loại này trong mục mở gần đây." />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
