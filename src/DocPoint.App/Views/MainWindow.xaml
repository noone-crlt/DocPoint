<ui:FluentWindow x:Class="DocPoint.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:DocPoint.App.ViewModels"
                 xmlns:pages="clr-namespace:DocPoint.App.Views.Pages"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
                 Title="DocPoint"
                 Width="1280" Height="800" MinWidth="1000" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 Background="{DynamicResource DpGroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{StaticResource DpUiFont}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusCommand, ElementName=SearchBox}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusCommand, ElementName=SearchBox}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding FocusCommand, ElementName=SearchBox}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Bìa hồ sơ: dải xanh rêu chạy suốt phía trên và dọc bên trái. -->
        <Border Grid.RowSpan="2" Background="{DynamicResource DpBiaBrush}" />

        <ui:TitleBar x:Name="TitleBar" Grid.ColumnSpan="2" Height="56" Padding="0"
                     Background="{DynamicResource DpBiaBrush}"
                     Foreground="{DynamicResource DpBiaTBrush}"
                     ButtonsForeground="{DynamicResource DpBiaTBrush}"
                     HorizontalContentAlignment="Center">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="76">
                        <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DpBiaTBrush}" />
                    </Grid>
                    <TextBlock Text="DocPoint" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="-10,0,8,0" Foreground="{DynamicResource DpBiaTBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.CenterContent>
                <ui:AutoSuggestBox x:Name="SearchBox"
                                   Width="620" Height="38"
                                   Background="{DynamicResource DpFieldBrush}"
                                   Foreground="{DynamicResource DpInkBrush}"
                                   PlaceholderText="{Binding SearchPlaceholder}"
                                   OriginalItemsSource="{Binding Suggestions}"
                                   Icon="{ui:SymbolIcon Search24}"
                                   AutomationProperties.Name="Tìm trong mọi tài liệu"
                                   ToolTip="Tìm kiếm (Ctrl+K)" />
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <!-- Thanh điều hướng trái -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="8,10,8,12">
            <StackPanel VerticalAlignment="Top">
                <RadioButton Style="{StaticResource RailItem}" Content="Trang chủ" Tag="{x:Static ui:SymbolRegular.Home24}"
                             IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Home}"
                             Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:HomePage}" />
                <RadioButton Style="{StaticResource RailItem}" Content="Thư viện" Tag="{x:Static ui:SymbolRegular.Library24}" Margin="0,4,0,0"
                             IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Library}"
                             Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:LibraryPage}" />
                <Grid Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource RailItem}" Content="Thư mục" Tag="{x:Static ui:SymbolRegular.Folder24}"
                                 IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Folders}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:FoldersPage}" />
                    <!-- Chấm vàng: đang đọc file. -->
                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38,8,0,0"
                             Fill="{DynamicResource DpHlBrush}" Stroke="{DynamicResource DpBiaBrush}" StrokeThickness="2"
                             IsHitTestVisible="False" ToolTip="Đang đọc file"
                             Visibility="{Binding IsReading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <RadioButton Style="{StaticResource RailItem}" Content="Đã ghim" Tag="{x:Static ui:SymbolRegular.Pin24}" Margin="0,4,0,0"
                             IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Pinned}"
                             Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:PinnedPage}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom">
                <RadioButton Style="{StaticResource RailItem}" Content="Sao lưu" Tag="{x:Static ui:SymbolRegular.Archive24}"
                             IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Backup}"
                             Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:BackupPage}" />
                <RadioButton Style="{StaticResource RailItem}" Content="Cài đặt" Tag="{x:Static ui:SymbolRegular.Settings24}" Margin="0,4,0,0"
                             IsChecked="{Binding ActiveSection, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Settings}"
                             Command="{Binding NavigateCommand}" CommandParameter="{x:Type pages:SettingsPage}" />
            </StackPanel>
        </Grid>

        <Frame x:Name="PageHost" Grid.Row="1" Grid.Column="1" NavigationUIVisibility="Hidden"
               Background="{DynamicResource DpGroundBrush}" />
    </Grid>
</ui:FluentWindow>
